# Copy this file to .env and adjust values for your environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pg_agents
APP_ENV=local
DB_POOL_SIZE=10

# Telegram bot token for notifications (optional).
TELEGRAM_BOT_TOKEN=

# CCXT exchange configuration (used by ingestion/execution agents).
EXCHANGE__ID=binance
EXCHANGE__API_KEY=
EXCHANGE__API_SECRET=
EXCHANGE__API_PASSWORD=
EXCHANGE__ENABLE_LIVE_TRADING=false
EXCHANGE__SANDBOX_MODE=true
EXCHANGE__DEFAULT_ORDER_SIZE=0.01

# Notification routing (Telegram chat/channel ids).
NOTIFICATIONS__ALERT_CHAT_ID=
NOTIFICATIONS__REPORT_CHAT_ID=

# Strategy tuning knobs (override YAML values when needed).
STRATEGY__SIGNAL_CONFIDENCE__THRESHOLD=0.7
STRATEGY__SIGNAL_CONFIDENCE__COOLDOWN_SECONDS=3600
STRATEGY__POSITION_SIZING__ACCOUNT_EQUITY_USD=10000
STRATEGY__POSITION_SIZING__RISK_PER_TRADE_PERCENT=1.0
STRATEGY__POSITION_SIZING__MAX_POSITION_NOTIONAL_USD=500
STRATEGY__POSITION_SIZING__MIN_POSITION_NOTIONAL_USD=10
STRATEGY__SWITCHES__EMA_TREND_PULLBACK=true
STRATEGY__SWITCHES__VOLUME_BREAKOUT=true
STRATEGY__SWITCHES__RSI_DIVERGENCE=true
STRATEGY__SWITCHES__BREAKOUT_RETEST=true
STRATEGY__SWITCHES__MACD_CROSSOVER=false
